# Noms des variables, sans valeur. Les fichiers .env* sont ignorés par git (sauf celui-ci).
# Sans DATABASE_URL, l'app utilise le fichier local pipeline.db (SQLite).
# En ligne (Vercel) : les deux variables sont obligatoires.
# Pour appliquer le schéma sur Turso : copie ce fichier en .env.turso.local, remplis-le,
# puis lance pnpm db:migrate:turso.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
